# CondoHub app-mobile — perfil ONLINE (REFERÊNCIA)
# O Flutter NÃO lê .env. Injete a URL da API publicada via --dart-define:
#   flutter run  --dart-define=CONDOHUB_API_BASE_URL=https://SUA-API-ONLINE.example.com/api/v1
#   flutter build apk --dart-define=CONDOHUB_API_BASE_URL=https://SUA-API-ONLINE.example.com/api/v1
CONDOHUB_API_BASE_URL=https://SUA-API-ONLINE.example.com/api/v1
