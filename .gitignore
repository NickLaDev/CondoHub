# =========================
# CondoHub - .gitignore
# Monorepo: Node backend + Flutter (mobile + web)
# =========================

# OS
.DS_Store
Thumbs.db

# IDEs / Editors
.vscode/
.idea/
*.iml
__pycache__/

# Secrets / env
# Só .env.example é versionado. Todo o resto contém segredos locais e nunca deve ir pro git.
.env
.env.local
.env.online
.env.dev
.env.*.local
!.env.example
!dev/app-mobile/.env.local
!dev/app-mobile/.env.online
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Node / TypeScript (backend)
# =========================
node_modules/
dist/
build/
coverage/
.cache/
.tmp/
.npm-cache/

# Uploads locais (UPLOAD_MODE=local)
dev/backend/var/uploads/*
!dev/backend/var/uploads/.gitkeep
.temp/
*.tsbuildinfo

# Next/Nuxt (se algum dia usar)
.next/
.nuxt/

# =========================
# Flutter / Dart (mobile + web-admin)
# =========================
.dart_tool/
.packages
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies

# Builds
build/
**/build/

# Android
**/android/.gradle/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/app/**/key.properties
**/android/app/**/upload-keystore.jks

# iOS / macOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Runner.xcworkspace/
**/ios/Runner/GeneratedPluginRegistrant.*
**/macos/Flutter/ephemeral/

# Linux / Windows (Flutter desktop, se usado)
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Web
**/.dart_tool/
**/web/.last_build_id

# =========================
# Firebase / Crashlytics (se usar)
# =========================
firebase-debug.log
**/ios/Runner/GoogleService-Info.plist
**/android/app/google-services.json

# =========================
# Assets gerados / exportações
# =========================
*.apk
*.aab
*.ipa

# =========================
# Docker / Infra (opcional)
# =========================
**/.docker/


#Pastas de planejamento

/Planejamento
/Entregas-Canvas

# Codex local runtime state
.codex/state/*.json
# (.env, .env.local e .env.online são versionados — ver bloco "Secrets / env" acima)
