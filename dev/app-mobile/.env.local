# CondoHub app-mobile — perfil LOCAL (REFERÊNCIA)
# IMPORTANTE: o Flutter NÃO lê arquivos .env automaticamente.
# A URL da API é injetada em tempo de build via --dart-define=CONDOHUB_API_BASE_URL=...
# (ver lib/core/config/app_config.dart, scripts/dev-all.sh e o README).
#
# iOS Simulator / desktop:
CONDOHUB_API_BASE_URL=http://localhost:3000/api/v1
# Android Emulator (mapeia o host em 10.0.2.2):
# CONDOHUB_API_BASE_URL=http://10.0.2.2:3000/api/v1
#
# Exemplo de uso manual:
#   flutter run --dart-define=CONDOHUB_API_BASE_URL=http://localhost:3000/api/v1
